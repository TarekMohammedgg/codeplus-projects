rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /doctors/{doctorId} {
      allow read: if true;
      allow create: if isAdmin();
      // Deactivate instead of delete, so booking history keeps its doctor.
      allow delete: if false;
      // A patient may only bump the rating aggregate in the same transaction
      // that creates a brand-new review (see ReviewService.submitReview).
      allow update: if isAdmin()
        || (
          signedIn()
          && changedOnly(['rating', 'reviewsCount', 'lastReviewId'])
          && request.resource.data.reviewsCount == resource.data.reviewsCount + 1
          && !exists(/databases/$(database)/documents/reviews/$(request.resource.data.lastReviewId))
          && existsAfter(/databases/$(database)/documents/reviews/$(request.resource.data.lastReviewId))
          && newReview().doctorId == doctorId
          // The new average must be the real one (client rounds to 2 decimals).
          && math.abs(request.resource.data.rating - expectedAverage()) < 0.01
        );

      function newReview() {
        return getAfter(/databases/$(database)/documents/reviews/$(request.resource.data.lastReviewId)).data;
      }

      function expectedAverage() {
        return (float(resource.data.get('rating', 0)) * resource.data.reviewsCount + newReview().rating)
          / (resource.data.reviewsCount + 1);
      }
    }

    match /specialty/{specialtyId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /clinic/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.role == 'patient'
        && request.resource.data.keys().hasOnly([
          'displayName',
          'email',
          'role',
          'phone',
          'dob',
          'gender',
          'photoUrl',
          'language',
          'notificationsEnabled',
          'createdAt',
          'updatedAt'
        ]);

      allow update: if isAdmin()
        || (
          isOwner(userId)
          && resource.data.role == 'patient'
          && request.resource.data.role == 'patient'
          && request.resource.data.keys().hasOnly([
            'displayName',
            'email',
            'role',
            'phone',
            'dob',
            'gender',
            'photoUrl',
            'language',
            'notificationsEnabled',
            'createdAt',
            'updatedAt'
          ])
        );

      allow delete: if isAdmin();

      match /favorites/{doctorId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Lock document per slot: it exists = the slot is taken. Created together
    // with its appointment in one transaction (AppointmentService.book).
    match /bookedSlots/{slotId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.patientId == request.auth.uid
        && existsAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId))
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.slotId == slotId
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.patientId == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin()
        || (signedIn() && resource.data.patientId == request.auth.uid);
    }

    match /appointments/{appointmentId} {
      allow read: if (signedIn() && resource.data.patientId == request.auth.uid)
        || isAdmin();

      // The doctor/fee snapshot must match the doctor doc, and the time must
      // match the slot lock created in the same transaction.
      allow create: if signedIn()
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.status == 'upcoming'
        && request.resource.data.isReviewed == false
        && request.resource.data.cancelledBy == null
        && request.resource.data.startAt > request.time
        && request.resource.data.slotId.matches(request.resource.data.doctorId + '_[0-9]{12}')
        && bookedDoctor().get('isActive', true) == true
        && request.resource.data.fee == bookedDoctor().consultationFee
        && request.resource.data.specialtyId == bookedDoctor().specialtyId
        && request.resource.data.doctorName.ar == bookedDoctor().fullName.ar
        && request.resource.data.doctorName.en == bookedDoctor().fullName.en
        && existsAfter(/databases/$(database)/documents/bookedSlots/$(request.resource.data.slotId))
        && bookedSlot().doctorId == request.resource.data.doctorId
        && bookedSlot().startAt == request.resource.data.startAt;

      function bookedDoctor() {
        return get(/databases/$(database)/documents/doctors/$(request.resource.data.doctorId)).data;
      }

      function bookedSlot() {
        return getAfter(/databases/$(database)/documents/bookedSlots/$(request.resource.data.slotId)).data;
      }

      // Admin: upcoming -> completed (only once the visit time has started),
      // or upcoming -> cancelled by admin.
      allow update: if isAdmin()
        && resource.data.status == 'upcoming'
        && changedOnly(['status', 'cancelledBy', 'updatedAt'])
        && (
          (
            request.resource.data.status == 'completed'
            && request.time >= resource.data.startAt
          )
          || (
            request.resource.data.status == 'cancelled'
            && request.resource.data.cancelledBy == 'admin'
          )
        );

      // Patient: cancel own upcoming appointment, before its time.
      allow update: if signedIn()
        && resource.data.patientId == request.auth.uid
        && resource.data.status == 'upcoming'
        && request.time < resource.data.startAt
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledBy == 'patient'
        && changedOnly(['status', 'cancelledBy', 'updatedAt']);

      // Patient: mark own completed appointment reviewed, only together with
      // creating its review (ReviewService.submitReview).
      allow update: if signedIn()
        && resource.data.patientId == request.auth.uid
        && resource.data.status == 'completed'
        && changedOnly(['isReviewed'])
        && request.resource.data.isReviewed == true
        && existsAfter(/databases/$(database)/documents/reviews/$(appointmentId));

      allow delete: if false;
    }

    // Review id = appointment id, so one review per appointment.
    match /reviews/{appointmentId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.appointmentId == appointmentId
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.get('comment', '').size() <= 500
        && get(/databases/$(database)/documents/appointments/$(appointmentId)).data.status == 'completed'
        && get(/databases/$(database)/documents/appointments/$(appointmentId)).data.patientId == request.auth.uid
        && get(/databases/$(database)/documents/appointments/$(appointmentId)).data.doctorId == request.resource.data.doctorId;
      allow update, delete: if false;
    }
  }
}
